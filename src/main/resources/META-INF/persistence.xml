<?xml version="1.0" encoding="UTF-8"?>

<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="
             https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

    <persistence-unit name="jpa-crud-unit"
                      transaction-type="RESOURCE_LOCAL">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>thuc.ute.entity.Category</class>
        <class>thuc.ute.entity.Video</class>
        <class>thuc.ute.entity.User</class>
        <class>thuc.ute.entity.Product</class>

        <properties>

            <!-- SQL Server Driver -->
            <property name="jakarta.persistence.jdbc.driver"
                      value="com.microsoft.sqlserver.jdbc.SQLServerDriver"/>

            <!-- Database URL -->
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:sqlserver://localhost:1433;databaseName=jpa_crud;encrypt=true;trustServerCertificate=true"/>

            <!-- SQL Server Username -->
            <property name="jakarta.persistence.jdbc.user"
                      value="sa"/>

            <!-- SQL Server Password -->
            <property name="jakarta.persistence.jdbc.password"
                      value="123456"/>

            <!-- Tự động tạo/cập nhật bảng -->
            <property name="hibernate.hbm2ddl.auto"
                      value="update"/>

            <!-- Hiển thị câu SQL trong Console -->
            <property name="hibernate.show_sql"
                      value="true"/>

            <!-- Format SQL dễ đọc -->
            <property name="hibernate.format_sql"
                      value="true"/>

        </properties>

    </persistence-unit>

</persistence>